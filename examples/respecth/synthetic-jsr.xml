    <property name="volume" units="cm3" sourcetype="calculated">
      <value>30</value>
    </property>
    <property name="initial composition" sourcetype="calculated">
      <component>
        <speciesLink preferredKey="H2" />
        <amount units="mole fraction">0.1111111111111111</amount>
      </component>
      <component>
        <speciesLink preferredKey="O2" />
        <amount units="mole fraction">0.05555555555555555</amount>
