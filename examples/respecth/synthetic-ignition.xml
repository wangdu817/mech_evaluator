    <property name="residence time" units="s" sourcetype="calculated">
      <value>0.05</value>
    </property>
    <property name="volume" units="cm3" sourcetype="calculated">
      <value>30</value>
    </property>
    <property name="initial composition" sourcetype="calculated">
      <component>
        <speciesLink preferredKey="H2" />
        <amount units="mole fraction">0.1111111111111111</amount>
      </component>
      <component>
        <speciesLink preferredKey="O2" />
        <amount units="mole fraction">0.05555555555555555</amount>
      </component>
      <component>
        <speciesLink preferredKey="AR" />
        <amount units="mole fraction">0.8333333333333334</amount>
      </component>
    </property>
  </commonProperties>
  <dataGroup id="dg1" label="Synthetic software fixture">
    <property name="temperature" id="T_column" label="T" units="K" sourcetype="calculated" />
    <property name="ignition delay" id="obs0" units="s" label="ignition delay" sourcetype="calculated" />
    <dataPoint>
      <T_column>1000</T_column>
      <obs0>0.0005</obs0>
    </dataPoint>
    <dataPoint>
      <T_column>1100</T_column>
      <obs0>0.00015</obs0>
    </dataPoint>
    <dataPoint>
      <T_column>1200</T_column>
      <obs0>6e-05</obs0>
    </dataPoint>
  </dataGroup>
  <ignitionType target="p" type="d/dt max" />
