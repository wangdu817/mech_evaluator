<?xml version='1.0' encoding='utf-8'?>
<experiment>
  <fileAuthor>Software validation fixture, not experimental measurements</fileAuthor>
  <fileVersion>
    <major>1</major>
    <minor>0</minor>
  </fileVersion>
  <ReSpecThVersion>
    <major>2</major>
    <minor>6</minor>
  </ReSpecThVersion>
  <experimentType>ignition delay measurement</experimentType>
  <apparatus>
    <kind>shock tube</kind>
